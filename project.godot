; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="3D_survival"
run/main_scene="uid://cmpehjugcnqvw"
config/features=PackedStringArray("4.5", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[augusts_item_system]

database/source_directory="res://Items/Resources"
database/catalogue_save_path="res://Items/_Generated/item_catalogue.tres"

[autoload]

EventSystem="*res://Game/EventSystem.gd"
InventoryManager="*res://InventorySystem/Singleton/inventory_manager.gd"
TimeManager="*res://DayNightSystem/TimeManager.gd"
ItemDatabase="*res://addons/augusts_item_system/src/item_database.gd"
NotificationSystem="*res://UI/NotificationUI/NotificationSystem.gd"
AudioManager="*res://addons/augusts_audio_manager/AudioManager.gd"
NPCEventSystem="*res://AgentSystem/Job/Singleton/NPCEventSystem.gd"
NPCTaskProcessor="*res://AgentSystem/Job/Singleton/NPCTaskProcessor.gd"
NPCJobBoard="*res://AgentSystem/Job/Singleton/NPCJobBoard.gd"
GameManager="*res://Managers/GameManager.gd"

[debug]

gdscript/warnings/integer_division=0

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[dotnet]

project/assembly_name="3D_survival"

[editor]

naming/scene_name_casing=1
naming/script_name_casing=1

[editor_plugins]

enabled=PackedStringArray("res://addons/augusts_audio_manager/plugin.cfg", "res://addons/augusts_item_system/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray"
}

