[layer_names]

3d_render/layer_1="Player"
3d_render/layer_2="Terrain"
3d_physics/layer_1="Ground"
3d_physics/layer_2="Friendly"
3d_physics/layer_3="Interactable"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

lights_and_shadows/directional_shadow/size.mobile=1024
global_illumination/gi/use_half_resolution=true
anti_aliasing/quality/screen_space_aa=2
mesh_lod/lod_change/threshold_pixels=2.0
lights_and_shadows/positional_shadow/atlas_quadrant_3_subdiv=3

[shader_globals]

wind_intensity={
"type": "float",
"value": 0.0
}
wind_direction={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
player_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
